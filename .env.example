# ---------------------------------------------------------------------------
# VYRAL configuration. Copy to .env.local for development.
# Every provider defaults to a clearly-labelled development implementation.
# The UI shows a "demonstration data" notice whenever any mock is active.
# ---------------------------------------------------------------------------

DATABASE_URL=postgres://vyral:vyral@127.0.0.1:5432/vyral
APP_URL=http://localhost:3000

# openssl rand -hex 32
SESSION_SECRET=
# openssl rand -base64 32  (encrypts linked social-account OAuth tokens at rest)
TOKEN_ENCRYPTION_KEY=

# Wallets granted the admin role when running `npm run db:seed` or `npm run admin:add -- <wallet>`
ADMIN_WALLETS=

# --- Solana -----------------------------------------------------------------
SOLANA_CLUSTER=devnet                 # devnet | mainnet-beta
SOLANA_RPC_URL=                       # dedicated RPC endpoint (required for live payouts/fees)
NEXT_PUBLIC_SOLANA_CLUSTER=devnet
NEXT_PUBLIC_SOLANA_RPC_URL=

# --- Providers ----------------------------------------------------------------
SOCIAL_PROVIDER=mock                  # mock | live
LAUNCH_PROVIDER=simulated             # simulated | pumpfun (production) | external
PRICE_PROVIDER=mock                   # mock | jupiter
FEE_PROVIDER=mock                     # mock | pumpfun (production) | onchain
PAYOUT_EXECUTOR=simulated             # simulated | solana
STORAGE_PROVIDER=local                # local | database (serverless hosts) | pinata

# --- Payouts (only with PAYOUT_EXECUTOR=solana) ------------------------------
FEE_VAULT_ADDRESS=                    # public key of the competition fee vault
PAYOUT_SIGNER=                        # env-keypair (hot wallet) | remote (KMS / custody signer)
PAYOUT_SIGNER_SECRET_KEY=             # the vault's secret key (base58 or JSON array) for env-keypair
# A key stored here on mainnet-beta is a hot wallet: allowed only when you opt in,
# and every single payout above PAYOUT_MAX_LAMPORTS is held for manual approval.
PAYOUT_ALLOW_HOT_WALLET=false
PAYOUT_MAX_LAMPORTS=5000000000        # 5 SOL
REMOTE_SIGNER_URL=
REMOTE_SIGNER_TOKEN=

# --- pump.fun launches (LAUNCH_PROVIDER=pumpfun) ----------------------------
# Creator fees are split 50/50 (reward vault / deployer) and locked on-chain in
# the launch transaction. Create the lookup table once (npm run pumpfun:lut).
PUMPFUN_LOOKUP_TABLE=

# --- Launch infrastructure (LAUNCH_PROVIDER=external) -------------------------
EXTERNAL_LAUNCH_API_URL=
EXTERNAL_LAUNCH_API_KEY=

# --- Market data ----------------------------------------------------------------
JUPITER_PRICE_API_URL=https://lite-api.jup.ag/price/v3

# --- Social platforms (SOCIAL_PROVIDER=live) ---------------------------------
YOUTUBE_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=
X_BEARER_TOKEN=
X_CLIENT_ID=
X_CLIENT_SECRET=

# --- Storage --------------------------------------------------------------------
UPLOAD_DIR=.data/uploads
PINATA_JWT=
PINATA_GATEWAY=

# Set to true only when running behind a trusted reverse proxy (Vercel: true).
TRUST_PROXY=false

# --- Serverless hosting (Vercel) ------------------------------------------------
# Secret for GET /api/cron/tick, which runs the background jobs when no
# long-running worker is available. Call it once a minute with
# "Authorization: Bearer <CRON_SECRET>" (or ?key=<CRON_SECRET>).
CRON_SECRET=
# `npm run vercel-build` seeds the labelled demo data into an empty database
# unless this is "false".
SEED_DEMO_DATA=true

# --- Legal pages (/legal/terms, /legal/privacy, /legal/imprint) ---------------
# Non-secret operator details shown in the Imprint, Terms and Privacy Policy.
# Missing values appear as highlighted placeholders. Address lines: separate with "|".
LEGAL_OPERATOR_NAME=
LEGAL_OPERATOR_ADDRESS=
LEGAL_CONTACT_EMAIL=
LEGAL_CONTACT_PHONE=
LEGAL_REPRESENTATIVE=
LEGAL_REGISTER=
LEGAL_VAT_ID=
LEGAL_GOVERNING_LAW=
# Set to true once a lawyer has reviewed the texts (hides the draft notice).
LEGAL_TEXTS_REVIEWED=false
